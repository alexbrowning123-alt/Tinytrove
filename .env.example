# ---- App ----
# Any host. Railway injects PORT automatically.
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# ---- Auth ----
# REQUIRED in production. A stable secret keeps users logged in across restarts.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Persistent storage (Railway volume) ----
# Mount a Railway volume and point both of these at it so the database and
# uploaded images survive redeploys. Example with a volume mounted at /data:
#   DATA_DIR=/data
#   UPLOAD_DIR=/data/uploads
DATA_DIR=
UPLOAD_DIR=
